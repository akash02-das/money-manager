# Application Configuration
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000

# Database Configuration (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://moneymanager:manager_secret_pass@localhost:5432/moneymanager_dev?schema=public"

# JWT Authentication Secrets (Prepared for Phase 2)
JWT_ACCESS_SECRET="dev_access_secret_money_manager_token_2026_super_safe_key_at_least_32_characters"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_SECRET="dev_refresh_secret_money_manager_token_2026_super_safe_key_at_least_32_characters"
JWT_REFRESH_EXPIRATION="7d"

# Cookie Signing Secret
COOKIE_SECRET="dev_cookie_signing_secret_money_manager_2026_min_32_characters"

# SMTP Email Dispatch Configuration (Optional in local dev, required for real emails)
# If left blank, verification codes are logged directly to the backend terminal console.
# For Gmail:
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-16-digit-gmail-app-password"
# SMTP_FROM='"Money Manager" <your-email@gmail.com>'
# FRONTEND_URL="http://localhost:3000"


